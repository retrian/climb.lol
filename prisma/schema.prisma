generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Leaderboard {
  id        String   @id @default(cuid())
  ownerId   String   @unique @map("owner_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leaderboards")
}
