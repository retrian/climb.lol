generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Leaderboard {
  id        String   @id @default(cuid())
  ownerId   String   @unique @map("owner_id")
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leaderboards")
}

model LeaderboardPlayer {
  id            String   @id @default(cuid())
  leaderboardId String   @map("leaderboard_id")
  puuid         String
  gameName      String   @map("game_name")
  tagLine       String   @map("tag_line")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([leaderboardId, puuid])
  @@index([leaderboardId])
  @@map("leaderboard_players")
}
